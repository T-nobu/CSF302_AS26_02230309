import math
import random

from closest import closest_pair, closest_pair_brute


def dist(points, i, j):
    return math.dist(points[i], points[j])


def check(points):
    """closest_pair must agree with brute force and return a valid pair."""
    d, i, j = closest_pair(points)
    db, _, _ = closest_pair_brute(points)
    assert math.isclose(d, db, rel_tol=1e-12, abs_tol=1e-12), (points, d, db)
    assert 0 <= i < j < len(points)
    assert math.isclose(dist(points, i, j), d, rel_tol=1e-12, abs_tol=1e-12)


def test_example_from_brief():
    pts = [(2, 3), (12, 30), (40, 50), (5, 1), (12, 10), (3, 4)]
    for f in (closest_pair_brute, closest_pair):
        d, i, j = f(pts)
        assert math.isclose(d, math.sqrt(2))
        assert (i, j) == (0, 5)


def test_random_500():
    rng = random.Random(302)
    for _ in range(500):
        n = rng.randint(2, 50)
        pts = [(rng.randint(-100, 100), rng.randint(-100, 100)) for _ in range(n)]
        check(pts)


def test_random_floats():
    rng = random.Random(7)
    for _ in range(200):
        n = rng.randint(2, 50)
        pts = [(rng.uniform(-50, 50), rng.uniform(-50, 50)) for _ in range(n)]
        check(pts)


def test_random_many_ties_small_grid():
    rng = random.Random(11)
    for _ in range(300):
        n = rng.randint(2, 50)
        pts = [(rng.randint(0, 5), rng.randint(0, 5)) for _ in range(n)]
        check(pts)


def test_exactly_two_points():
    assert closest_pair([(0, 0), (3, 4)]) == (5.0, 0, 1)
    assert closest_pair([(3, 4), (0, 0)]) == (5.0, 0, 1)
    assert closest_pair_brute([(0, 0), (3, 4)]) == (5.0, 0, 1)


def test_duplicate_points():
    pts = [(1, 1), (5, 5), (9, 2), (5, 5), (7, 7)]
    d, i, j = closest_pair(pts)
    assert d == 0 and (i, j) == (1, 3)
    assert closest_pair_brute(pts)[0] == 0
    d, i, j = closest_pair([(4, 4), (4, 4)])
    assert (d, i, j) == (0, 0, 1)
    check([(2, 2)] * 20)                      # all identical


def test_all_on_vertical_line():
    # every x equal: the dividing line passes through every point
    pts = [(5, y) for y in (0, 10, 20, 31, 33, 50, 70, 90)]
    d, i, j = closest_pair(pts)
    assert d == 2 and (i, j) == (3, 4)
    rng = random.Random(3)
    for _ in range(100):
        pts = [(5, rng.randint(-1000, 1000)) for _ in range(rng.randint(2, 50))]
        check(pts)


def test_all_on_horizontal_line():
    rng = random.Random(4)
    for _ in range(100):
        pts = [(rng.randint(-1000, 1000), 8) for _ in range(rng.randint(2, 50))]
        check(pts)


def test_closest_pair_straddles_dividing_line():
    # Left half spread out, right half spread out, closest pair across the middle.
    pts = [(0, 0), (0, 100), (10, 50), (10.5, 50), (21, 0), (21, 100)]
    d, i, j = closest_pair(pts)
    assert math.isclose(d, 0.5) and (i, j) == (2, 3)
    # Larger: halves each have min gap 10, the cross pair has 1.
    left = [(x, 0) for x in range(0, 100, 10)]          # x=0..90
    right = [(x, 0) for x in range(91, 191, 10)]        # x=91..181
    pts = left + right
    d, i, j = closest_pair(pts)
    assert d == 1 and pts[i] == (90, 0) and pts[j] == (91, 0)
    # Cross pair at different heights, inside the strip but far in y order
    pts = [(0, 0), (0, 40), (0, 80), (9.9, 41), (20, 0), (20, 40), (20, 80), (20, 120)]
    check(pts)
    d, i, j = closest_pair(pts)
    assert pts[i] == (0, 40) and pts[j] == (9.9, 41)


def test_negative_coordinates_and_unsorted_input():
    pts = [(-5, -5), (100, 100), (-4, -5), (50, -60), (-100, 20)]
    d, i, j = closest_pair(pts)
    assert d == 1 and (i, j) == (0, 2)


def test_larger_random_agrees():
    rng = random.Random(99)
    pts = [(rng.random() * 1000, rng.random() * 1000) for _ in range(2000)]
    check(pts)


def test_too_few_points():
    import pytest
    for f in (closest_pair, closest_pair_brute):
        with pytest.raises(ValueError):
            f([(1, 1)])