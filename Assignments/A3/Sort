"""Quicksort variants for the nightly transaction sort (in place, ascending).

quicksort_basic          Lomuto partition, last element as pivot.
quicksort_improved       random pivot + insertion sort for small parts +
                         recurse on the smaller part, loop on the larger.
quicksort_improved_3way  (extra) same as improved but with a 3-way partition,
                         so runs of equal values are not re-sorted.
"""
import random


def _insertion_sort(a, lo, hi):
    """Insertion sort of a[lo..hi] (inclusive)."""
    for i in range(lo + 1, hi + 1):
        x = a[i]
        j = i - 1
        while j >= lo and a[j] > x:
            a[j + 1] = a[j]
            j -= 1
        a[j + 1] = x


# ---------------------------------------------------------------- basic
def quicksort_basic(a):
    """Lomuto partition, pivot = last element. Recursion on both parts."""
    _qs_basic(a, 0, len(a) - 1)


def _qs_basic(a, lo, hi):
    if lo >= hi:
        return
    pivot = a[hi]
    i = lo
    for j in range(lo, hi):
        if a[j] <= pivot:
            a[i], a[j] = a[j], a[i]
            i += 1
    a[i], a[hi] = a[hi], a[i]
    _qs_basic(a, lo, i - 1)
    _qs_basic(a, i + 1, hi)


# ------------------------------------------------------------- improved
def quicksort_improved(a, cutoff=16):
    """Random pivot (Lomuto), insertion sort for parts of size <= cutoff,
    recurse on the smaller part and loop on the larger (depth O(log n))."""
    _qs_improved(a, 0, len(a) - 1, cutoff)


def _qs_improved(a, lo, hi, cutoff):
    randint = random.randint
    while hi - lo + 1 > cutoff:
        p = randint(lo, hi)                      # random pivot
        a[p], a[hi] = a[hi], a[p]
        pivot = a[hi]
        i = lo
        for j in range(lo, hi):
            if a[j] <= pivot:
                a[i], a[j] = a[j], a[i]
                i += 1
        a[i], a[hi] = a[hi], a[i]
        if i - lo < hi - i:                      # left part is smaller
            _qs_improved(a, lo, i - 1, cutoff)   # recurse on smaller
            lo = i + 1                           # loop on larger
        else:
            _qs_improved(a, i + 1, hi, cutoff)
            hi = i - 1
    _insertion_sort(a, lo, hi)


# --------------------------------------------------- extra: 3-way version
def quicksort_improved_3way(a, cutoff=16):
    """Like quicksort_improved, but partitions into <, ==, > pivot."""
    _qs_3way(a, 0, len(a) - 1, cutoff)


def _qs_3way(a, lo, hi, cutoff):
    randint = random.randint
    while hi - lo + 1 > cutoff:
        pivot = a[randint(lo, hi)]
        lt, i, gt = lo, lo, hi
        while i <= gt:
            x = a[i]
            if x < pivot:
                a[lt], a[i] = x, a[lt]
                lt += 1
                i += 1
            elif x > pivot:
                a[i], a[gt] = a[gt], x
                gt -= 1
            else:
                i += 1
        if lt - lo < hi - gt:
            _qs_3way(a, lo, lt - 1, cutoff)
            lo = gt + 1
        else:
            _qs_3way(a, gt + 1, hi, cutoff)
            hi = lt - 1
    _insertion_sort(a, lo, hi)