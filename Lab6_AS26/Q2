"""Q2: Matrix chain multiplication - bottom-up DP, parenthesisation, brute-force check."""
import random

random.seed(3)


def matrix_chain(p):
    """p = dimensions; matrix Ai is p[i-1] x p[i]. Returns (cost table m, split table s)."""
    n = len(p) - 1
    m = [[0] * (n + 1) for _ in range(n + 1)]
    s = [[0] * (n + 1) for _ in range(n + 1)]
    for length in range(2, n + 1):
        for i in range(1, n - length + 2):
            j = i + length - 1
            m[i][j] = float("inf")
            for k in range(i, j):
                cost = m[i][k] + m[k + 1][j] + p[i - 1] * p[k] * p[j]
                if cost < m[i][j]:
                    m[i][j], s[i][j] = cost, k
    return m, s


def parens(s, i, j):
    if i == j:
        return f"A{i}"
    return "(" + parens(s, i, s[i][j]) + parens(s, s[i][j] + 1, j) + ")"


def brute_force(p, i, j):
    """Plain recursion over every split point, no memoization."""
    if i == j:
        return 0
    return min(brute_force(p, i, k) + brute_force(p, k + 1, j) + p[i - 1] * p[k] * p[j]
               for k in range(i, j))


def left_to_right(p):
    return sum(p[0] * p[i] * p[i + 1] for i in range(1, len(p) - 1))


def report(label, p):
    n = len(p) - 1
    m, s = matrix_chain(p)
    best = m[1][n]
    line = f"{label}: dims {p}\n    optimal cost      : {best:,}\n    parenthesisation  : {parens(s, 1, n)}\n"
    line += f"    left-to-right cost: {left_to_right(p):,}"
    if n <= 8:
        bf = brute_force(p, 1, n)
        assert bf == best, (p, bf, best)
        line += f"\n    brute force       : {bf:,}  (matches DP)"
    print(line + "\n")


def main():
    print("=== Matrix chain multiplication ===\n")
    report("Test 1", [30, 35, 15, 5, 10, 20, 25])
    assert matrix_chain([30, 35, 15, 5, 10, 20, 25])[0][1][6] == 15125
    report("Test 2", [5, 4, 6, 2, 7])
    for t in range(1, 6):
        n = random.randint(3, 8)
        report(f"Random {t}", [random.randint(5, 50) for _ in range(n + 1)])


if __name__ == "__main__":
    main()