"""Q2: Counting sort and LSD radix sort vs merge sort.

Experiment A: n = 100,000, k = 10, 10^3, 10^5, 10^7   (counting sort vs merge sort)
Experiment B: k = 10^9, n = 10,000 .. 1,000,000        (radix base 10, radix base 256, merge sort)
Stability demo: sort (key, original_index) pairs by key only.

NOTE: replace merge_sort() below with your own Lab 1 merge sort if required.

Usage:  python q2_counting_radix.py            (full run)
        python q2_counting_radix.py --quick    (smaller sizes, for testing)
"""
import argparse
import random
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

random.seed(1)


# ------------------------------------------------------------ Counting sort
def counting_sort(a, k, key=lambda x: x):
    """Stable counting sort. key(x) must be an int in 0..k."""
    count = [0] * (k + 1)
    for x in a:
        count[key(x)] += 1
    for v in range(1, k + 1):          # prefix sums: count[v] = # items with key <= v
        count[v] += count[v - 1]
    out = [None] * len(a)
    for x in reversed(a):              # right-to-left keeps equal keys in original order
        kx = key(x)
        count[kx] -= 1
        out[count[kx]] = x
    return out


# ------------------------------------------------------------ Radix sort
def _count_by_digit(a, exp, base):
    count = [0] * base
    digits = [(x // exp) % base for x in a]
    for d in digits:
        count[d] += 1
    for v in range(1, base):
        count[v] += count[v - 1]
    out = [0] * len(a)
    for i in range(len(a) - 1, -1, -1):
        d = digits[i]
        count[d] -= 1
        out[count[d]] = a[i]
    return out


def radix_sort(a, base=10):
    """LSD radix sort for non-negative ints; one stable counting-sort pass per digit."""
    if not a:
        return a
    m = max(a)
    exp = 1
    while m // exp > 0:
        a = _count_by_digit(a, exp, base)
        exp *= base
    return a


# ------------------------------------------------------------ Merge sort (Lab 1 stand-in)
def merge_sort(a):
    if len(a) <= 1:
        return a
    mid = len(a) // 2
    left, right = merge_sort(a[:mid]), merge_sort(a[mid:])
    out, i, j = [], 0, 0
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            out.append(left[i]); i += 1
        else:
            out.append(right[j]); j += 1
    out.extend(left[i:])
    out.extend(right[j:])
    return out


def timed(fn, *args):
    t0 = time.perf_counter()
    res = fn(*args)
    return res, time.perf_counter() - t0


def stability_demo():
    print("=== Stability check: sorting (key, original_index) by key only ===")
    pairs = [(random.randint(0, 4), i) for i in range(20)]
    print("input :", pairs)
    out = counting_sort(pairs, 4, key=lambda p: p[0])
    print("output:", out)
    stable = all(out[i][0] < out[i + 1][0] or
                 (out[i][0] == out[i + 1][0] and out[i][1] < out[i + 1][1])
                 for i in range(len(out) - 1))
    print("Stable (equal keys keep increasing original index):", stable, "\n")
    assert stable


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--quick", action="store_true")
    args = ap.parse_args()

    stability_demo()

    # ---------------- Experiment A
    n = 10_000 if args.quick else 100_000
    ks = [10, 10**3, 10**5, 10**7]
    cs, ms = [], []
    print(f"=== Experiment A: n = {n:,}, vary k ===")
    print(f"{'k':>12} {'counting (s)':>14} {'merge (s)':>12}")
    for k in ks:
        data = [random.randint(0, k) for _ in range(n)]
        res_c, tc = timed(counting_sort, data, k)
        res_m, tm = timed(merge_sort, data)
        assert res_c == res_m == sorted(data)
        cs.append(tc); ms.append(tm)
        print(f"{k:>12,} {tc:>14.4f} {tm:>12.4f}")

    plt.figure(figsize=(6, 4))
    plt.plot(ks, cs, "o-", label="Counting sort")
    plt.plot(ks, ms, "s-", label="Merge sort")
    plt.xscale("log"); plt.yscale("log")
    plt.xlabel("k (max key)"); plt.ylabel("time (s)")
    plt.title(f"Experiment A: n = {n:,}")
    plt.legend(); plt.grid(True, which="both", alpha=0.3)
    plt.tight_layout(); plt.savefig("q2_counting_vs_k.png", dpi=150)

    # ---------------- Experiment B
    k = 10**9
    ns = [10_000, 50_000, 100_000, 500_000, 1_000_000]
    if args.quick:
        ns = [5_000, 10_000, 20_000]
    r10, r256, mrg = [], [], []
    print(f"\n=== Experiment B: k = 10^9, vary n ===")
    print(f"{'n':>10} {'radix b=10':>12} {'radix b=256':>13} {'merge (s)':>11}")
    for n in ns:
        data = [random.randint(0, k) for _ in range(n)]
        a, t10 = timed(radix_sort, data, 10)
        b, t256 = timed(radix_sort, data, 256)
        c, tm = timed(merge_sort, data)
        assert a == b == c == sorted(data)
        r10.append(t10); r256.append(t256); mrg.append(tm)
        print(f"{n:>10,} {t10:>12.3f} {t256:>13.3f} {tm:>11.3f}")

    plt.figure(figsize=(6, 4))
    plt.plot(ns, r10, "o-", label="Radix (base 10)")
    plt.plot(ns, r256, "^-", label="Radix (base 256)")
    plt.plot(ns, mrg, "s-", label="Merge sort")
    plt.xscale("log"); plt.yscale("log")
    plt.xlabel("n"); plt.ylabel("time (s)")
    plt.title("Experiment B: k = 10^9")
    plt.legend(); plt.grid(True, which="both", alpha=0.3)
    plt.tight_layout(); plt.savefig("q2_radix_vs_n.png", dpi=150)
    print("\nSaved q2_counting_vs_k.png and q2_radix_vs_n.png")


if __name__ == "__main__":
    main()